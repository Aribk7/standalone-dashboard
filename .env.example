# Copy to .env.local for local development, and add the same names in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Optional. If unset, a secret is derived from SUPABASE_SERVICE_ROLE_KEY.
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored API keys and keys the PIN lookup. Changing it signs everyone
# out and invalidates every stored key and PIN.
APP_SECRET=

# Filled in automatically by Vercel's Supabase integration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: allow "explore with sample data" in production (always on locally).
# ENABLE_DEMO=1
